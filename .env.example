# Browser-facing API origin (no /api suffix).
PUBLIC_API_URL=http://localhost:3000
# API origin used by the SSR server (inside Docker: http://api:3000).
API_INTERNAL_URL=http://localhost:3000
# Public origin of the storefront, used for canonical URLs.
PUBLIC_SITE_URL=http://localhost:8080
# Analytics ids; leave empty to keep analytics off. Metrika is digits, GA4 looks like G-XXXXXXXXXX.
PUBLIC_METRIKA_ID=
PUBLIC_GA4_ID=
